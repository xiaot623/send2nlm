{
  "manifest_version": 3,
  "name": "Send2NLM",
  "version": "0.0.1",
  "description": "Send the current page to NotebookLM through a local daemon.",
  "default_locale": "en",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["http://localhost:*/*", "http://127.0.0.1:*/*"],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Send2NLM",
    "default_popup": "dist/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
